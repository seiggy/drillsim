<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="docfx.json" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="docfx.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="OSDC.DotnetLibraries.General.Common" Version="1.1.1" />
		<PackageReference Include="OSDC.DotnetLibraries.General.DataManagement" Version="2.2.0" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalUnitConversionProjects)' != 'true'">
		<PackageReference Include="OSDC.UnitConversion.Conversion.UnitSystem.DrillingEngineering" Version="3.4.1" />
	</ItemGroup>

	<ItemGroup Condition="'$(UseLocalUnitConversionProjects)' == 'true'">
		<ProjectReference Include="..\ConversionUnitSystem.DrillingEngineering\ConversionUnitSystem.DrillingEngineering.csproj" />
	</ItemGroup>

</Project>
