{
  "openapi": "3.0.4",
  "info": {
    "title": "OSDC Earth Vertical Datum API",
    "description": "Stateless bidirectional conversion between EGM84 mean-sea-level and WGS84 ellipsoidal depths using OSDC SI and positive-down conventions.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/EarthVerticalDatum/api"
    }
  ],
  "paths": {
    "/EarthVerticalDatum": {
      "get": {
        "tags": [
          "EarthVerticalDatum"
        ],
        "summary": "Returns the loaded EGM84-30 geoid-model information for service discovery.",
        "description": "This is the microservice entry endpoint. It returns the same model identity and provenance as the ModelInfo endpoint.",
        "operationId": "GetEarthVerticalDatumEntry",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.EarthVerticalDatumModelInfo"
                }
              }
            }
          }
        }
      }
    },
    "/EarthVerticalDatum/ConvertMeanSeaLevelToWgs84": {
      "post": {
        "tags": [
          "EarthVerticalDatum"
        ],
        "summary": "Synchronously converts EGM84 mean-sea-level depths to WGS84 ellipsoidal depths.",
        "description": "This operation is stateless. Latitude and longitude are WGS84 radians. Input and output depths are SI metres, positive downward from their explicitly named reference surfaces. The complete request is rejected if any position is invalid.",
        "operationId": "ConvertMeanSeaLevelToWgs84",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.MeanSeaLevelToWgs84Request"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.MeanSeaLevelToWgs84Request"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.MeanSeaLevelToWgs84Request"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.MeanSeaLevelToWgs84Response"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.EarthVerticalDatumValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/EarthVerticalDatum/ConvertWgs84ToMeanSeaLevel": {
      "post": {
        "tags": [
          "EarthVerticalDatum"
        ],
        "summary": "Synchronously converts WGS84 ellipsoidal depths to EGM84 mean-sea-level depths.",
        "description": "This inverse operation is stateless. Latitude and longitude are WGS84 radians. Input and output depths are SI metres, positive downward from their explicitly named reference surfaces. The complete request is rejected if any position is invalid.",
        "operationId": "ConvertWgs84ToMeanSeaLevel",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.Wgs84ToMeanSeaLevelRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.Wgs84ToMeanSeaLevelRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.Wgs84ToMeanSeaLevelRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.Wgs84ToMeanSeaLevelResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.EarthVerticalDatumValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/EarthVerticalDatum/ModelInfo": {
      "get": {
        "tags": [
          "EarthVerticalDatum"
        ],
        "summary": "Returns the loaded EGM84-30 geoid model identity, resolution, interpolation accuracy, runtime version, and coefficient hash.",
        "operationId": "GetEarthVerticalDatumModelInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.EarthVerticalDatumModelInfo"
                }
              }
            }
          }
        }
      }
    },
    "/EarthVerticalDatumUsageStatistics": {
      "get": {
        "tags": [
          "EarthVerticalDatumUsageStatistics"
        ],
        "summary": "Returns in-memory usage counters for this service replica. This operation is intentionally not exposed as an MCP tool.",
        "operationId": "GetEarthVerticalDatumUsageStatistics",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthVerticalDatum.Model.UsageStatisticsEarthVerticalDatum"
                }
              }
            }
          }
        }
      }
    }
  },
