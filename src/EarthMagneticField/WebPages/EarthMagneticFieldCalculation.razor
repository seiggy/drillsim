@page "/EarthMagneticFieldCalculation"
@inject ILogger<EarthMagneticFieldCalculation> Logger
@inject ISnackbar Snackbar
@inject IEarthMagneticFieldAPIUtils Api

<MudUnitAndReferenceChoiceTag HttpHost="@Api.HostNameUnitConversion"
                              HttpBasePath="@Api.HostBasePathUnitConversion"
                              HttpController="UnitSystem/"
                              UnitSystemName="@DataUtils.UnitAndReferenceParameters.UnitSystemName"
                              UnitSystemNameChanged="@DataUtils.UpdateUnitSystemName">
    <MudPaper Class="pa-6 mt-4" Elevation="2">
        <MudText Typo="Typo.h4" Class="mb-2">Earth magnetic field evaluation</MudText>
        <MudText Typo="Typo.body2" Class="mb-4">
            Evaluate WMM2025 or IGRF14 at a WGS84 position and UTC instant. The API uses radians, metres positive
            downward from the WGS84 ellipsoid, and north-east-down magnetic flux density in SI teslas.
            Displayed engineering units follow the selected OSDC unit system.
        </MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="EarthMagneticFieldModel" Label="Magnetic reference model" @bind-Value="selectedModel">
                    <MudSelectItem Value="EarthMagneticFieldModel.WMM2025">WMM2025 (2025–2030)</MudSelectItem>
                    <MudSelectItem Value="EarthMagneticFieldModel.IGRF14">IGRF14 (1900–2030)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" Label="UTC evaluation instant" HelperText="RFC 3339 with Z, for example 2026-08-24T10:00:00Z"
                              @bind-Value="dateTimeUtcText" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudInputAngleWithUnitAdornment QuantityLabel="Sexagesimal latitude (WGS84)"
                                                SIValueNullable="latitude"
                                                SIValueNullableChanged="@(value => latitude = value)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudInputWithUnitAdornment QuantityName="PlaneAngleGeodesic" QuantityLabel="Decimal latitude (WGS84)"
                                           SIValueNullable="latitude" SIValueNullableChanged="@(value => latitude = value)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudInputAngleWithUnitAdornment QuantityLabel="Sexagesimal longitude (WGS84)"
                                                SIValueNullable="longitude"
                                                SIValueNullableChanged="@(value => longitude = value)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudInputWithUnitAdornment QuantityName="PlaneAngleGeodesic" QuantityLabel="Decimal longitude (WGS84)"
                                           SIValueNullable="longitude" SIValueNullableChanged="@(value => longitude = value)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudInputWithUnitAdornment QuantityName="DepthDrilling" QuantityLabel="Depth below WGS84 ellipsoid"
                                           SIValueNullable="depth" SIValueNullableChanged="@(value => depth = value)" />
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EvaluateAsync" Disabled="evaluating">Evaluate</MudButton>
                @if (evaluating)
                {
                    <MudProgressCircular Class="ml-4" Indeterminate="true" Size="Size.Small" />
                }
            </MudItem>
        </MudGrid>

        @if (result != null)
        {
            <MudDivider Class="my-5" />
            <MudText Typo="Typo.h5" Class="mb-3">North-east-down result</MudText>
            <MudGrid>
                <MudItem xs="12" md="4"><MudInputWithUnitAdornment QuantityName="EarthMagneticFluxDensity" QuantityLabel="North" ReadOnly="true" SIValueNullable="result.North" /></MudItem>
                <MudItem xs="12" md="4"><MudInputWithUnitAdornment QuantityName="EarthMagneticFluxDensity" QuantityLabel="East" ReadOnly="true" SIValueNullable="result.East" /></MudItem>
                <MudItem xs="12" md="4"><MudInputWithUnitAdornment QuantityName="EarthMagneticFluxDensity" QuantityLabel="Down" ReadOnly="true" SIValueNullable="result.Down" /></MudItem>
                <MudItem xs="12" md="4"><MudInputWithUnitAdornment QuantityName="EarthMagneticFluxDensity" QuantityLabel="Horizontal intensity" ReadOnly="true" SIValueNullable="result.HorizontalIntensity" /></MudItem>
                <MudItem xs="12" md="4"><MudInputWithUnitAdornment QuantityName="EarthMagneticFluxDensity" QuantityLabel="Total intensity" ReadOnly="true" SIValueNullable="result.TotalIntensity" /></MudItem>
                <MudItem xs="12" md="4"><MudInputWithUnitAdornment QuantityName="PlaneAngleDrilling" QuantityLabel="Declination (positive east)" ReadOnly="true" SIValueNullable="result.Declination" /></MudItem>
                <MudItem xs="12" md="4"><MudInputWithUnitAdornment QuantityName="PlaneAngleDrilling" QuantityLabel="Inclination (positive down)" ReadOnly="true" SIValueNullable="result.Inclination" /></MudItem>
            </MudGrid>
            <MudText Typo="Typo.caption" Class="mt-3">Model: @modelInfo?.Description (@modelInfo?.ID). UTC: @result.Input.DateTimeUtc.ToString("O").</MudText>
        }
    </MudPaper>
</MudUnitAndReferenceChoiceTag>

@code {
    private EarthMagneticFieldModel selectedModel = EarthMagneticFieldModel.WMM2025;
    private string dateTimeUtcText = DateTimeOffset.UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture);
    private double? latitude;
    private double? longitude;
    private double? depth;
    private bool evaluating;
    private EarthMagneticFieldSample? result;
    private EarthMagneticModelInfo? modelInfo;

    private async Task EvaluateAsync()
    {
        if (latitude is null || longitude is null || depth is null)
        {
            Snackbar.Add("Latitude, longitude, and depth are required.", Severity.Warning);
            return;
        }
        if (!double.IsFinite(latitude.Value) || latitude < -Math.PI / 2 || latitude > Math.PI / 2 ||
            !double.IsFinite(longitude.Value) || longitude < -Math.PI || longitude > Math.PI || !double.IsFinite(depth.Value))
        {
            Snackbar.Add("The SI latitude, longitude, or depth is outside the supported range.", Severity.Warning);
            return;
        }
        if (!DateTimeOffset.TryParse(dateTimeUtcText, System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.RoundtripKind, out DateTimeOffset dateTimeUtc) || dateTimeUtc.Offset != TimeSpan.Zero)
        {
            Snackbar.Add("Enter an explicit UTC timestamp containing Z or +00:00.", Severity.Warning);
            return;
        }

        try
        {
            evaluating = true;
            var request = new EvaluateEarthMagneticFieldRequest
            {
                Model = selectedModel,
                Samples =
                [
                    new EarthMagneticFieldEvaluationPoint
                    {
                        Latitude = latitude.Value,
                        Longitude = longitude.Value,
                        Depth = depth.Value,
                        DateTimeUtc = dateTimeUtc
                    }
                ]
            };
            EvaluateEarthMagneticFieldResponse response = await Api.ClientEarthMagneticField.EvaluateEarthMagneticFieldAsync(request);
            result = response.Samples?.FirstOrDefault();
            modelInfo = response.Model;
            Snackbar.Add("Earth magnetic field evaluation completed.", Severity.Success);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Earth magnetic field evaluation failed");
            Snackbar.Add("Earth magnetic field evaluation failed: " + exception.Message, Severity.Error);
        }
        finally
        {
            evaluating = false;
        }
    }
}
