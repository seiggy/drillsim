{
  "openapi": "3.0.4",
  "info": {
    "title": "OSDC Earth Gravity API",
    "description": "Stateless EGM96 evaluation using OSDC SI and WGS84 conventions.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/EarthGravity/api"
    }
  ],
  "paths": {
    "/EarthGravity": {
      "get": {
        "tags": [
          "EarthGravity"
        ],
        "summary": "Returns the loaded EGM96 model information for service discovery.",
        "description": "This is the microservice entry endpoint. It returns the same model identity and provenance as the ModelInfo endpoint.",
        "operationId": "GetEarthGravityEntry",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityModelInfo"
                }
              }
            }
          }
        }
      }
    },
    "/EarthGravity/Evaluate": {
      "post": {
        "tags": [
          "EarthGravity"
        ],
        "summary": "Synchronously evaluates EGM96 total gravity for WGS84 positions expressed in OSDC SI units.",
        "description": "This operation is stateless. Latitude and longitude are radians. Depth is metres, positive downward from the WGS84 reference ellipsoid. The complete request is rejected if any position is invalid.",
        "operationId": "EvaluateEarthGravity",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityEvaluationRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityEvaluationRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityEvaluationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityEvaluationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/EarthGravity/ModelInfo": {
      "get": {
        "tags": [
          "EarthGravity"
        ],
        "summary": "Returns the loaded EGM96 model identity, provenance, degree, order, runtime version, and coefficient hash.",
        "operationId": "GetEarthGravityModelInfo",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityModelInfo"
                }
              }
            }
          }
        }
      }
    },
    "/EarthGravityUsageStatistics": {
      "get": {
        "tags": [
          "EarthGravityUsageStatistics"
        ],
        "summary": "Returns in-memory usage counters for this service replica. This operation is intentionally not exposed as an MCP tool.",
        "operationId": "GetEarthGravityUsageStatistics",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.UsageStatisticsEarthGravity"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OSDC.Drilling.EarthGravity.Model.EarthGravityEvaluationRequest": {
        "required": [
          "positions"
        ],
        "type": "object",
        "properties": {
          "positions": {
            "$ref": "#/components/schemas/System.Collections.Generic.List`1[[OSDC.Drilling.EarthGravity.Model.EarthGravityPosition, Model, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null]]"
          }
        },
        "description": "A stateless synchronous EGM96 evaluation request."
      },
      "OSDC.Drilling.EarthGravity.Model.EarthGravityEvaluationResponse": {
        "type": "object",
        "properties": {
          "model": {
            "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityModelInfo"
          },
          "samples": {
            "$ref": "#/components/schemas/System.Collections.Generic.List`1[[OSDC.Drilling.EarthGravity.Model.EarthGravitySample, Model, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null]]"
          }
        },
        "description": "EGM96 results in the same order as the request positions."
      },
      "OSDC.Drilling.EarthGravity.Model.EarthGravityModelInfo": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/System.String"
          },
          "id": {
            "$ref": "#/components/schemas/System.String"
          },
          "publisher": {
            "$ref": "#/components/schemas/System.String"
          },
          "releaseDate": {
            "$ref": "#/components/schemas/System.String"
          },
          "dataVersion": {
            "$ref": "#/components/schemas/System.String"
          },
          "degree": {
            "$ref": "#/components/schemas/System.Int32"
          },
          "order": {
            "$ref": "#/components/schemas/System.Int32"
          },
          "geographicLibVersion": {
            "$ref": "#/components/schemas/System.String"
          },
          "referenceEllipsoid": {
            "$ref": "#/components/schemas/System.String"
          },
          "includesCentrifugalAcceleration": {
            "$ref": "#/components/schemas/System.Boolean"
          },
          "coefficientSHA256": {
            "$ref": "#/components/schemas/System.String"
          }
        },
        "description": "Identity and provenance of the Earth gravity model used for an evaluation."
      },
      "OSDC.Drilling.EarthGravity.Model.EarthGravityPosition": {
        "type": "object",
        "properties": {
          "latitude": {
            "$ref": "#/components/schemas/System.Double"
          },
          "longitude": {
            "$ref": "#/components/schemas/System.Double"
          },
          "depth": {
            "$ref": "#/components/schemas/System.Double"
          }
        },
        "description": "A position referred to the WGS84 reference ellipsoid and expressed using OSDC SI conventions."
      },
      "OSDC.Drilling.EarthGravity.Model.EarthGravitySample": {
        "type": "object",
        "properties": {
          "position": {
            "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityPosition"
          },
          "gravity": {
            "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityVector"
          }
        },
        "description": "An evaluated WGS84 position and its corresponding EGM96 gravity vector."
      },
      "OSDC.Drilling.EarthGravity.Model.EarthGravityValidationError": {
        "required": [
          "positionIndex",
          "property",
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "positionIndex": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/System.Nullable`1[[System.Int32, System.Private.CoreLib, Version=10.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e]]"
              }
            ],
            "nullable": true
          },
          "property": {
            "$ref": "#/components/schemas/System.String"
          },
          "code": {
            "$ref": "#/components/schemas/System.String"
          },
          "message": {
            "$ref": "#/components/schemas/System.String"
          }
        }
      },
      "OSDC.Drilling.EarthGravity.Model.EarthGravityValidationProblem": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/System.String"
          },
          "message": {
            "$ref": "#/components/schemas/System.String"
          },
          "errors": {
            "$ref": "#/components/schemas/System.Collections.Generic.List`1[[OSDC.Drilling.EarthGravity.Model.EarthGravityValidationError, Model, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null]]"
          }
        },
        "description": "Details returned when an evaluation request is rejected atomically."
      },
      "OSDC.Drilling.EarthGravity.Model.EarthGravityVector": {
        "type": "object",
        "properties": {
          "east": {
            "$ref": "#/components/schemas/System.Double"
          },
          "north": {
            "$ref": "#/components/schemas/System.Double"
          },
          "up": {
            "$ref": "#/components/schemas/System.Double"
          },
          "magnitude": {
            "$ref": "#/components/schemas/System.Double"
          },
          "totalPotential": {
            "$ref": "#/components/schemas/System.Double"
          }
        },
        "description": "Total gravity acceleration in the local east-north-up frame."
      },
      "OSDC.Drilling.EarthGravity.Model.UsageStatisticsEarthGravity": {
        "type": "object",
        "properties": {
          "startedAt": {
            "$ref": "#/components/schemas/System.DateTimeOffset"
          },
          "scope": {
            "$ref": "#/components/schemas/System.String"
          },
          "restEvaluations": {
            "$ref": "#/components/schemas/System.Int64"
          },
          "mcpEvaluations": {
            "$ref": "#/components/schemas/System.Int64"
          },
          "failedEvaluations": {
            "$ref": "#/components/schemas/System.Int64"
          },
          "positionsEvaluated": {
            "$ref": "#/components/schemas/System.Int64"
          },
          "modelInfoRequests": {
            "$ref": "#/components/schemas/System.Int64"
          },
          "statisticsRequests": {
            "$ref": "#/components/schemas/System.Int64"
          }
        }
      },
      "System.Boolean": {
        "type": "boolean"
      },
      "System.Collections.Generic.List`1[[OSDC.Drilling.EarthGravity.Model.EarthGravityPosition, Model, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null]]": {
        "minItems": 1,
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityPosition"
        }
      },
      "System.Collections.Generic.List`1[[OSDC.Drilling.EarthGravity.Model.EarthGravitySample, Model, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null]]": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravitySample"
        }
      },
      "System.Collections.Generic.List`1[[OSDC.Drilling.EarthGravity.Model.EarthGravityValidationError, Model, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null]]": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/OSDC.Drilling.EarthGravity.Model.EarthGravityValidationError"
        }
      },
      "System.DateTimeOffset": {
        "type": "string",
        "format": "date-time"
      },
      "System.Double": {
        "maximum": 1.5707963267948966,
        "minimum": -1.5707963267948966,
        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
        "format": "double"
      },
      "System.Int32": {
        "pattern": "^-?(?:0|[1-9]\\d*)$",
        "format": "int32"
      },
      "System.Int64": {
        "pattern": "^-?(?:0|[1-9]\\d*)$",
        "format": "int64"
      },
      "System.Nullable`1[[System.Int32, System.Private.CoreLib, Version=10.0.0.0, Culture=neutral, PublicKeyToken=7cec85d7bea7798e]]": {
        "pattern": "^-?(?:0|[1-9]\\d*)$",
        "format": "int32"
      },
      "System.String": {
        "type": "string"
      }
    }
  },
  "tags": [
    {
      "name": "EarthGravity"
    },
    {
      "name": "EarthGravityUsageStatistics"
    }
  ]
}